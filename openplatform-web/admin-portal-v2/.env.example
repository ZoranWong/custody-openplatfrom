# 【admin-portal-v2】环境变量模板
# 复制为 .env（通用）、.env.production（生产）、.env.development（开发）后按需修改。
#
# 注意：本项目的 vite.config.ts 读取的是 VITE_BASE_URL（不是 VITE_BASE）。

# ===== .env（通用）=====
#  版本号
VITE_VERSION = 1.0.0

# 端口号
VITE_PORT = 1002

# 应用部署基础路径（对应 nginx location /openplatform/admin/）
VITE_BASE_URL = /openplatform/admin/

# API 请求地址（生产环境经 nginx /openplatform/api/ 转发到网关）
VITE_API_URL = /openplatform/api/v1

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = frontend

# 跨域请求时是否携带 Cookie
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = change-me

# ===== .env.production（生产）=====
# VITE_BASE_URL = /openplatform/admin/
# VITE_API_URL = /openplatform/api/v1
# VITE_DROP_CONSOLE = true

# ===== .env.development（开发）=====
# VITE_BASE_URL = /openplatform-admin/
# VITE_API_URL = /api/v1
# VITE_API_PROXY_URL = http://localhost:1000
# VITE_DROP_CONSOLE = false
