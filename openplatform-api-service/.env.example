# JWT Secret - MUST be set in production (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# JWT RSA Keys (Base64-encoded, for RS256 signing)
# Generate with: npx tsx scripts/generate-jwt-keys.ts
JWT_PRIVATE_KEY=<generated>
JWT_PUBLIC_KEY=<generated>

# Server configuration
PORT=3000
NODE_ENV=development
